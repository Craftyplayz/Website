RewriteCond %{HTTP_HOST} ^craftyplayz.com [NC]
RewriteRule ^(.*)$ http://www.craftyplayz.com/$1 [L,R=301]
ErrorDocument 404 /404.php
RewriteEngine On

# Phase 7: short links (/go/<name> -> data/links.json), XML sitemap, and the files they replace
RewriteRule ^go/([A-Za-z0-9_-]+)/?$ /go/index.php?k=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ /sitemap-xml.php [L]
RedirectMatch 301 ^/invite(\.php)?$ /go/discord
RedirectMatch 301 ^/spotify(\.html)?$ /go/spotify
RedirectMatch 301 ^/php/404(\.php)?$ /404.php
RedirectMatch 301 ^/php/layout\.js$ /assets/js/site.js
<Files "links.json">
    Require all denied
</Files>

# Browser caching for static files outside /assets (those aren't versioned, so keep it short)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico|mp3|mp4|ogg|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "^site\.json$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>
</IfModule>

# ---- Old URLs from the reorganisation (see plan.html) ----
# Duplicate folders that were removed
RedirectMatch 301 ^/(Code/)?minecraft/items_1\.21\.11/(.*)$ /minecraft/tools/item-list/$2
RedirectMatch 301 ^/Code/minecraft/(.*)$ /minecraft/$1
RedirectMatch 301 ^/images/minecraft/skins/download/(.*)$ /media/minecraft/skins/$1
# images/ split into /assets/img (site graphics) and /media (photos, screenshots, covers)
RedirectMatch 301 ^/images/(catsmall\.webp|checkmark\.png|partial\.png)$ /assets/img/$1
RedirectMatch 301 ^/images/minecraft/shoplogo\.png$ /assets/img/shoplogo.png
RedirectMatch 301 ^/images/(icons|markers)/(.*)$ /assets/img/$1/$2
RedirectMatch 301 ^/images/SlideShows/homepagemobile/(.*)$ /media/slideshow/mobile/$1
RedirectMatch 301 ^/images/SlideShows/homepage/(.*)$ /media/slideshow/desktop/$1
RedirectMatch 301 ^/images/galleries/pets/(.*)$ /media/pets/$1
RedirectMatch 301 ^/images/minecraft/rawscreenshots/(.*)$ /media/minecraft/screenshots-raw/$1
RedirectMatch 301 ^/images/minecraft/weird.sizes/(.*)$ /media/minecraft/misc/$1
RedirectMatch 301 ^/images/minecraft/(screenshots|mapart|skins)/(.*)$ /media/minecraft/$1/$2
RedirectMatch 301 ^/images/books/(.*)$ /media/books/covers/$1
RedirectMatch 301 ^/images/(harrypotter|quotes)/(.*)$ /media/$1/$2
RedirectMatch 301 ^/images/update/(.*)$ /media/fake-updates/$1
RedirectMatch 301 ^/images/trump-mugshot\.webp$ /media/memes/trump-mugshot.webp
# css/ moved to /assets/css
RedirectMatch 301 ^/css/global\.css$ /assets/css/legacy.css
RedirectMatch 301 ^/css/fakescreen/win10\.css$ /assets/css/pages/win10.css
RedirectMatch 301 ^/css/hypixel/collection\.css$ /assets/css/pages/hypixel-collection.css
RedirectMatch 301 ^/css/(books|dnd|factorio|gallery|homepage|minecraft|speedtest|steam|steamnew|tools)\.css$ /assets/css/pages/$1.css
# Duplicate or old page versions (archived in /_dev/archive)
RedirectMatch 301 ^/minecraft/test(\.php)?$ /minecraft/tools/stats-editor/
RedirectMatch 301 ^/minecraft/schemcalc(\.html)?$ /minecraft/tools/shulker-calculator/
RedirectMatch 301 ^/hypixel/hotm(\.php)?$ /games/hypixel/
RedirectMatch 301 ^/hypixel/minions2(\.php)?$ /games/hypixel/minions/
RedirectMatch 301 ^/hypixel/collections/melonwar2(\.php)?$ /games/hypixel/collections/melon-war/
RedirectMatch 301 ^/books/index2(\.php)?$ /books/
RedirectMatch 301 ^/steam/(steam2|newgame)(\.php)?(/.*)?$ /games/steam/
RedirectMatch 301 ^/steam/gamer(/.*)?$ /games/steam/
RedirectMatch 301 ^/tools/random/image2(\.php)?$ /tools/random/image/
RedirectMatch 301 ^/Code/transcripts/index2(\.php)?$ /private/transcripts/
RedirectMatch 301 ^/extras/thegame/temp(/.*)?$ /games/the-game/
RedirectMatch 301 ^/books/hannah(\.php)?$ /books/
# Personal pages moved to the password-protected /private/
RedirectMatch 301 ^/Code/(bs|transcripts|downloads)(/.*)?$ /private/$1$2
RedirectMatch 301 ^/Code/booru(\.php)?$ /private/booru/
RedirectMatch 301 ^/Code/jelly(\.php)?$ /private/jellyfin/
RedirectMatch 301 ^/Code/(timesince\.php|redirect\.html)$ /private/scripts/$1
RedirectMatch 301 ^/books/kindlecontrol(\.html)?$ /private/kindle/
RedirectMatch 301 ^/books/pages(\.php)?$ /private/kindle/pages.php
# Phase 6: Minecraft pages moved into /minecraft/tools/, /minecraft/projects/ and folders of their own
RedirectMatch 301 ^/minecraft/nbtviewer(/.*)?$ /minecraft/tools/nbt-viewer$1
RedirectMatch 301 ^/minecraft/itemlist(/.*)?$ /minecraft/tools/item-list$1
RedirectMatch 301 ^/minecraft/nether(\.html)?$ /minecraft/tools/nether-portal/
RedirectMatch 301 ^/minecraft/storage/(index\.html)?$ /minecraft/tools/storage-sorter/
RedirectMatch 301 ^/minecraft/storage(/.*)?$ /minecraft/tools/storage-sorter$1
RedirectMatch 301 ^/minecraft/shulker-schematic-calculator(\.html)?$ /minecraft/tools/shulker-calculator/
RedirectMatch 301 ^/minecraft/materiallist(\.html)?$ /minecraft/tools/material-list/
RedirectMatch 301 ^/minecraft/litematica_material_converter(\.html)?$ /minecraft/tools/litematica-converter/
RedirectMatch 301 ^/minecraft/day(\.php)?$ /minecraft/tools/day-calculator/
RedirectMatch 301 ^/minecraft/marker(\.php)?$ /minecraft/tools/dynmap-marker/
RedirectMatch 301 ^/minecraft/minecart(\.html)?$ /minecraft/tools/book-generator/
RedirectMatch 301 ^/minecraft/transactions(\.html)?$ /minecraft/tools/transaction-generator/
RedirectMatch 301 ^/Code/names\.csv$ /minecraft/tools/transaction-generator/names.csv
RedirectMatch 301 ^/minecraft/stats(\.php)?$ /minecraft/tools/stats-editor/
RedirectMatch 301 ^/minecraft/chatfilter(\.php)?$ /minecraft/tools/json-viewer/
RedirectMatch 301 ^/minecraft/minigames(/battleships(\.html)?)?/?$ /minecraft/tools/tnt-cannon/
RedirectMatch 301 ^/minecraft/playtime/(index\.html)?$ /minecraft/tools/playtime/
RedirectMatch 301 ^/minecraft/playtime(/.*)?$ /minecraft/tools/playtime$1
RedirectMatch 301 ^/minecraft/network/(index\.php)?$ /minecraft/projects/metro/
RedirectMatch 301 ^/minecraft/network(/.*)?$ /minecraft/projects/metro$1
RedirectMatch 301 ^/minecraft/boltnetwork(\.php)?$ /minecraft/projects/rail-router/
RedirectMatch 301 ^/minecraft/milestones(\.php)?$ /minecraft/projects/milestones/
RedirectMatch 301 ^/minecraft/stonecrest(\.php)?$ /minecraft/projects/stonecrest/
RedirectMatch 301 ^/minecraft/mapart/code(/.*)?$ /minecraft/projects/map-art/frame-extractor/
RedirectMatch 301 ^/minecraft/mapart(/.*)?$ /minecraft/projects/map-art/
RedirectMatch 301 ^/minecraft/life/s1/e([1-3])(\.php)?$ /minecraft/projects/life-series/season-1/session-$1/
RedirectMatch 301 ^/minecraft/life(/.*)?$ /minecraft/projects/life-series/
RedirectMatch 301 ^/minecraft/screenshot(\.php)?$ /minecraft/screenshots/
RedirectMatch 301 ^/minecraft/(skins|tips)(\.php)?$ /minecraft/$1/
RedirectMatch 301 "^/minecraft/Invisible Bossbar \(all\)\.zip$" "/minecraft/downloads/Invisible Bossbar (all).zip"
# the Captainalism shop moved under Minecraft
RedirectMatch 301 ^/shop/?$ /minecraft/shop/
RedirectMatch 301 ^/shop/index(\.php)?$ /minecraft/shop/
RedirectMatch 301 ^/shop/books(\.php)?$ /minecraft/shop/enchanted-books/
RedirectMatch 301 ^/shop/(requests|casino)(\.php)?$ /minecraft/shop/$1/
RedirectMatch 301 ^/shop/upcoming(\.php)?$ /minecraft/shop/
RedirectMatch 301 ^/shop/styles\.css$ /minecraft/shop/styles.css
# Phase 6: everything game-related moved under /games/
RedirectMatch 301 ^/steam/?$ /games/steam/
RedirectMatch 301 ^/steam/index(\.php)?$ /games/steam/
RedirectMatch 301 ^/steam/game(\.php)?/?$ /games/steam/game/
RedirectMatch 301 ^/steam/game/([0-9]+)/?$ /games/steam/game/?game=$1
RedirectMatch 301 ^/steam/data/(.*)$ /games/steam/data/$1
RedirectMatch 301 ^/retro(/.*)?$ /games/retro/
RedirectMatch 301 ^/factorio/map(\.php)?/?$ /games/factorio/map/
RedirectMatch 301 ^/factorio(/.*)?$ /games/factorio/
RedirectMatch 301 ^/Code/factorio(\.html)?$ /games/factorio/commands/
RedirectMatch 301 ^/hypixel/?$ /games/hypixel/
RedirectMatch 301 ^/hypixel/index(\.php)?$ /games/hypixel/
RedirectMatch 301 ^/hypixel/minions(\.php)?$ /games/hypixel/minions/
RedirectMatch 301 ^/hypixel/calculators/ghast(\.php)?$ /games/hypixel/ghast-calculator/
RedirectMatch 301 ^/hypixel/calculators/bazaar\.json$ /games/hypixel/ghast-calculator/bazaar.json
RedirectMatch 301 ^/hypixel/collections/?$ /games/hypixel/collections/
RedirectMatch 301 ^/hypixel/collections/index(\.php)?$ /games/hypixel/collections/
RedirectMatch 301 ^/hypixel/collections/track(\.php)?$ /games/hypixel/collections/track/
RedirectMatch 301 ^/hypixel/collections/melonwar(\.php)?$ /games/hypixel/collections/melon-war/
RedirectMatch 301 ^/hypixel/filter(\.html)?$ /games/hypixel/regex-builder/
# quiz URLs were linked with mixed case (/quiz/harrypotter/normal), so match any case
RedirectMatch 301 (?i)^/quiz/?$ /games/quizzes/
RedirectMatch 301 (?i)^/quiz/harrypotter/?$ /games/quizzes/harry-potter/
RedirectMatch 301 (?i)^/quiz/harrypotter/normal(/.*)?$ /games/quizzes/harry-potter/medium/
RedirectMatch 301 (?i)^/quiz/harrypotter/(easy|medium|hard|extrahard)(/.*)?$ /games/quizzes/harry-potter/$1$2
RedirectMatch 301 ^/games/yugioh/yugioh(\.php)?$ /games/yugioh/
RedirectMatch 301 ^/games/yugioh/yugioh2(\.php)?$ /games/yugioh/next-packs/
RedirectMatch 301 ^/games/yugioh/sets(\.php)?$ /games/yugioh/sets/
RedirectMatch 301 ^/games/yugioh/extrarules(\.php)?$ /games/yugioh/extra-rules/
RedirectMatch 301 ^/extras/thegame(/.*)?$ /games/the-game/
RedirectMatch 301 ^/Code/skyrim(\.html)?$ /games/skyrim/
# Phase 6: Books
RedirectMatch 301 ^/books/cover(\.php)?$ /books/covers/
RedirectMatch 301 ^/books/bulkcover(\.php)?$ /books/covers/bulk/
RedirectMatch 301 ^/extras/harrypotter/?$ /books/harry-potter/
RedirectMatch 301 ^/extras/harrypotter/characters(\.php)?$ /books/harry-potter/
RedirectMatch 301 ^/extras/harrypotter/(character|info|quiz)(\.php)?$ /books/harry-potter/$1/
RedirectMatch 301 ^/extras/harrypotter/json/(.*)$ /books/harry-potter/json/$1
# Phase 6: Tools
RedirectMatch 301 ^/tools/random/(number|image)(\.php)?$ /tools/random/$1/
RedirectMatch 301 ^/extras/qr(\.php)?$ /tools/qr-code/
RedirectMatch 301 ^/extras/santa(/.*)?$ /tools/secret-santa$1
RedirectMatch 301 ^/tests/speedtest(\.php)?$ /tools/reading-speed/
RedirectMatch 301 ^/tests/speedtest/(.*)$ /tools/reading-speed/$1
RedirectMatch 301 ^/tests/?$ /tools/
RedirectMatch 301 ^/Code/docker(\.php)?$ /tools/docker-script/
RedirectMatch 301 ^/Code/install(\.html)?$ /tools/install-script/
RedirectMatch 301 ^/Code(/|/index\.php)?$ /tools/
# Phase 6: Extras (pages into folders of their own; update/, memes/, photos/, quote.php joined them)
RedirectMatch 301 ^/extras/trump(\.php)?$ /extras/trump-quotes/
RedirectMatch 301 ^/extras/insult(\.php)?$ /extras/insults/
RedirectMatch 301 ^/extras/fact(\.php)?$ /extras/facts/
RedirectMatch 301 ^/extras/livelaughlove(\.php)?$ /extras/live-laugh-love/
RedirectMatch 301 ^/extras/(cyberpunk|brb)\.php$ /extras/$1/
RedirectMatch 301 ^/extras/bee(\.php)?$ /extras/bee-movie/
RedirectMatch 301 ^/ext[ra]+s/(rbg|rgb)(\.php)?$ /extras/flashing-colours/
RedirectMatch 301 ^/ext[ra]+s/chaos(\.html)?$ /extras/twitch-chat/
RedirectMatch 301 ^/update(/.*)?$ /extras/fake-updates$1
RedirectMatch 301 ^/memes/?$ /extras/memes/
RedirectMatch 301 ^/memes/meme(\.html)?$ /extras/memes/
RedirectMatch 301 ^/memes/(.+)$ /extras/memes/$1
RedirectMatch 301 ^/photos/?$ /extras/pets/
RedirectMatch 301 ^/photos/pets(\.php)?$ /extras/pets/
RedirectMatch 301 ^/photos/pet(\.php)?$ /extras/pets/pet/
RedirectMatch 301 ^/quote(\.php)?$ /extras/quotes/
RedirectMatch 301 ^/konami\.js$ /assets/js/konami.js

<IfModule mod_deflate.c>
         AddOutputFilterByType DEFLATE application/javascript
         AddOutputFilterByType DEFLATE application/rss+xml
         AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
         AddOutputFilterByType DEFLATE application/x-font
         AddOutputFilterByType DEFLATE application/x-font-opentype
         AddOutputFilterByType DEFLATE application/x-font-otf
         AddOutputFilterByType DEFLATE application/x-font-truetype
         AddOutputFilterByType DEFLATE application/x-font-ttf
         AddOutputFilterByType DEFLATE application/x-javascript
         AddOutputFilterByType DEFLATE application/xhtml+xml
         AddOutputFilterByType DEFLATE application/xml
         AddOutputFilterByType DEFLATE font/opentype
         AddOutputFilterByType DEFLATE font/otf
         AddOutputFilterByType DEFLATE font/ttf
         AddOutputFilterByType DEFLATE image/svg+xml
         AddOutputFilterByType DEFLATE image/x-icon
         AddOutputFilterByType DEFLATE text/css
         AddOutputFilterByType DEFLATE text/html
         AddOutputFilterByType DEFLATE text/javascript
         AddOutputFilterByType DEFLATE text/plain
          AddOutputFilterByType DEFLATE text/xml
</IfModule>