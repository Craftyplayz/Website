RewriteCond %{HTTP_HOST} ^craftyplayz.com [NC]
RewriteRule ^(.*)$ http://www.craftyplayz.com/$1 [L,R=301]
ErrorDocument 404 /php/404
RewriteEngine On

# ---- Old URLs from the reorganisation (see plan.html) ----
# Duplicate folders that were removed
RedirectMatch 301 ^/(Code/)?minecraft/items_1\.21\.11/(.*)$ /minecraft/itemlist/$2
RedirectMatch 301 ^/Code/minecraft/(.*)$ /minecraft/$1
RedirectMatch 301 ^/images/minecraft/skins/download/(.*)$ /images/minecraft/skins/$1
# Duplicate or old page versions (archived in /_dev/archive)
RedirectMatch 301 ^/minecraft/test(\.php)?$ /minecraft/stats.php
RedirectMatch 301 ^/minecraft/schemcalc(\.html)?$ /minecraft/shulker-schematic-calculator.html
RedirectMatch 301 ^/hypixel/hotm(\.php)?$ /hypixel/
RedirectMatch 301 ^/hypixel/minions2(\.php)?$ /hypixel/minions.php
RedirectMatch 301 ^/hypixel/collections/melonwar2(\.php)?$ /hypixel/collections/melonwar.php
RedirectMatch 301 ^/books/index2(\.php)?$ /books/
RedirectMatch 301 ^/steam/(steam2|newgame)(\.php)?(/.*)?$ /steam/
RedirectMatch 301 ^/steam/gamer(/.*)?$ /steam/
RedirectMatch 301 ^/tools/random/image2(\.php)?$ /tools/random/image.php
RedirectMatch 301 ^/Code/transcripts/index2(\.php)?$ /private/transcripts/
RedirectMatch 301 ^/extras/thegame/temp(/.*)?$ /extras/thegame/
RedirectMatch 301 ^/books/hannah(\.php)?$ /books/
# Personal pages moved to the password-protected /private/
RedirectMatch 301 ^/Code/(bs|transcripts|downloads)(/.*)?$ /private/$1$2
RedirectMatch 301 ^/Code/booru(\.php)?$ /private/booru/
RedirectMatch 301 ^/Code/jelly(\.php)?$ /private/jellyfin/
RedirectMatch 301 ^/Code/(timesince\.php|redirect\.html)$ /private/scripts/$1
RedirectMatch 301 ^/books/kindlecontrol(\.html)?$ /private/kindle/
RedirectMatch 301 ^/books/pages(\.php)?$ /private/kindle/pages.php

<IfModule mod_deflate.c>
         AddOutputFilterByType DEFLATE application/javascript
         AddOutputFilterByType DEFLATE application/rss+xml
         AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
         AddOutputFilterByType DEFLATE application/x-font
         AddOutputFilterByType DEFLATE application/x-font-opentype
         AddOutputFilterByType DEFLATE application/x-font-otf
         AddOutputFilterByType DEFLATE application/x-font-truetype
         AddOutputFilterByType DEFLATE application/x-font-ttf
         AddOutputFilterByType DEFLATE application/x-javascript
         AddOutputFilterByType DEFLATE application/xhtml+xml
         AddOutputFilterByType DEFLATE application/xml
         AddOutputFilterByType DEFLATE font/opentype
         AddOutputFilterByType DEFLATE font/otf
         AddOutputFilterByType DEFLATE font/ttf
         AddOutputFilterByType DEFLATE image/svg+xml
         AddOutputFilterByType DEFLATE image/x-icon
         AddOutputFilterByType DEFLATE text/css
         AddOutputFilterByType DEFLATE text/html
         AddOutputFilterByType DEFLATE text/javascript
         AddOutputFilterByType DEFLATE text/plain
          AddOutputFilterByType DEFLATE text/xml
</IfModule>