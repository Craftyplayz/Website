# Password protection for everything in /private/
#
# One-time setup:
# 1. Create the password file in Git Bash on your PC (it asks for the password twice):
#        printf 'crafty:%s\n' "$(openssl passwd -apr1)" > private/.htpasswd
#    Change "crafty" to whatever username you want. Upload private/.htpasswd to the
#    server. It is gitignored, so never commit it.
# 2. Replace the AuthUserFile path below with the full server path to that file.
#    To find it, upload a file to the site root containing  <?php echo __DIR__;
#    open it in the browser, then delete it. On IONOS it looks like
#    /homepages/12/d123456789/htdocs - add /private/.htpasswd to the end.
#
# Until both steps are done, /private/ shows an error instead of opening - it never fails open.

AuthType Basic
AuthName "Private"
AuthUserFile /CHANGE/ME/private/.htpasswd
Require valid-user

# never serve the password file itself
<Files ".ht*">
    Require all denied
</Files>

# keep these pages out of search engines
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
