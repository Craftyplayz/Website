# API keys and passwords - copy php/config.example.php to php/config.php and fill it in
php/config.php
# password file for /private/ - see private/.htaccess
private/.htpasswd

# Python bytecode
__pycache__/

# data the live site writes at runtime
games/the-game/thegame.json

# personal recordings and chat exports - kept on the server only, never in the public repo
private/transcripts/*.ogg
private/bs/*.html
private/bs/shroom.php

# frame tool output (local only)
_dev/frame-tool/output/

# progress ticked in /private/minecraft/ - written on the server, never deployed over
minecraft/projects/farms/done.json
minecraft/projects/collection/done.json

# homebrew sheet server backups - written on the server, never committed (they hold visitor IPs)
private/dnd/backups/
private/dnd/monster-backups/
# the same D&D data after the move to dnd.craftyplayz.com (2026-11-02): archived, never committed
_dev/archive/dnd/private/dnd/backups/
_dev/archive/dnd/private/dnd/monster-backups/
_dev/archive/dnd/private/transcripts/*.ogg
_dev/archive/dnd/private/transcripts/transcripts/
_dev/archive/dnd/games/dnd/transcripts/data/*
!_dev/archive/dnd/games/dnd/transcripts/data/.gitignore
!_dev/archive/dnd/games/dnd/transcripts/data/.htaccess
_dev/archive/dnd/games/dnd/characters/cache/*.json

# Discord recap stats (personal: message text, who I talk to) - built by _dev/discord-recap, server only
private/discord/*/data.js
# per-person login for each recap folder except crafty (server only: holds the real server path)
private/discord/*/.ht*

# booru saved groups/presets - written by /private/booru/ on the server
private/booru/booru_data.json
