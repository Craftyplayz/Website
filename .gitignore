# API keys and passwords - copy php/config.example.php to php/config.php and fill it in
php/config.php
# password file for /private/ - see private/.htaccess
private/.htpasswd

# Python bytecode
__pycache__/

# data the live site writes at runtime
games/the-game/thegame.json

# personal recordings and chat exports - kept on the server only, never in the public repo
private/transcripts/*.ogg
private/bs/*.html
private/bs/shroom.php

# frame tool output (local only)
_dev/frame-tool/output/

# progress ticked in /private/minecraft/ - written on the server, never deployed over
minecraft/projects/farms/done.json
minecraft/projects/collection/done.json

# homebrew sheet server backups - written on the server, never committed (they hold visitor IPs)
private/dnd/backups/
private/dnd/monster-backups/
