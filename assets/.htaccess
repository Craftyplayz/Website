# Everything in /assets is linked with ?v=<last modified> (see asset() in includes/functions.php),
# so browsers can keep it for a year and still get changes straight away.
# (Inside FilesMatch so it wins over the shorter FilesMatch rule in the root .htaccess.)
<IfModule mod_headers.c>
    <FilesMatch ".+">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
